{
  "name": "relenzworks/infraregister",
  "description": "Infrastructure asset records and lifecycle operations for ISP and enterprise environments.",
  "type": "library",
  "license": "GPL-3.0-or-later",
  "require": {
    "php": "^8.3",
    "symfony/console": "^7.4",
    "symfony/filesystem": "^7.4",
    "symfony/http-foundation": "^7.4",
    "symfony/ldap": "^7.4",
    "symfony/security-core": "^7.4",
    "symfony/uid": "^6.4 || ^7.0",
    "symfony/validator": "^6.4 || ^7.0"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.64",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^10.5 || ^11.0"
  },
  "autoload": {
    "psr-4": {
      "RelenzWorks\\InfraRegister\\": "src/"
    }
  },
  "bin": [
    "bin/infraregister"
  ],
  "autoload-dev": {
    "psr-4": {
      "RelenzWorks\\InfraRegister\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "test:coverage": "XDEBUG_MODE=coverage phpunit --coverage-text --coverage-clover=build/logs/clover.xml && php tools/assert-coverage.php build/logs/clover.xml 100",
    "analyse": "phpstan analyse --configuration=phpstan.neon --memory-limit=512M",
    "cs:check": "php-cs-fixer fix --dry-run --diff --config=.php-cs-fixer.php",
    "cs:fix": "php-cs-fixer fix --config=.php-cs-fixer.php",
    "quality": [
      "@cs:check",
      "@analyse",
      "@test"
    ]
  },
  "config": {
    "allow-plugins": {
      "phpstan/extension-installer": true
    },
    "platform": {
      "php": "8.3.0"
    },
    "sort-packages": true
  },
  "minimum-stability": "stable"
}
